{
  "manifest_version": 3,
  "name": "Traductor — puente de transcripción",
  "version": "1.0",
  "description": "Envía el texto de subtítulos de la pestaña actual al Traductor local (localhost:8000).",
  "host_permissions": [
    "http://localhost:8000/*",
    "http://127.0.0.1:8000/*"
  ],
  "background": { "service_worker": "background.js" },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "all_frames": true,
      "run_at": "document_idle",
      "js": ["content.js"]
    }
  ],
  "action": { "default_title": "Traductor: puente activo" }
}
